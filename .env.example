# Local development placeholders only. Replace before using shared infrastructure.
APP_NAME=floodguard-api
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
# Preferred over generic DEBUG, which some host shells use for other purposes.
APP_DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
POSTGRES_DB=floodguard
POSTGRES_USER=floodguard
POSTGRES_PASSWORD=change-me-local-only
# Host-process URLs. Compose overrides these with service-name URLs.
DATABASE_URL=postgresql+asyncpg://floodguard:change-me-local-only@localhost:5432/floodguard
REDIS_URL=redis://localhost:6379/0
HEALTH_CHECK_TIMEOUT_SECONDS=2
REDIS_REQUIRED=true
ENABLE_SIMULATION_API=true
USE_FIXTURE_ROUTING=false
ACTIVE_ROUTE_TTL_SECONDS=900
# Browser URL: Docker service names are not resolvable in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Official PostGIS images may require x86 emulation on Apple Silicon.
POSTGIS_PLATFORM=linux/amd64

# Phase 15: EventBridge routes external domain events into the existing SQS queue.
# Enable SQS_ENABLED too when selecting EVENT_TRANSPORT=EVENTBRIDGE.
EVENTBRIDGE_ENABLED=false
EVENTBRIDGE_BUS_NAME=floodguard-dev-events
EVENTBRIDGE_SOURCE=com.floodguard
# Optional local AWS-compatible endpoint; unset for AWS.
# EVENTBRIDGE_ENDPOINT_URL=http://localhost:4566
EVENT_TRANSPORT=IN_PROCESS
SQS_ENABLED=false
AWS_REGION=ap-south-1
# Set to the existing Standard queue before enabling either asynchronous mode.
SQS_ENVIRONMENT_QUEUE_URL=http://localhost:4566/000000000000/floodguard-events-standard
